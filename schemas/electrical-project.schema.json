{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/votecoffee/AutoCADMCPServer/schemas/electrical-project.schema.json",
  "title": "AutoCAD MCP electrical evidence snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "analysis_signature",
    "root_id",
    "inputs",
    "drawings",
    "devices",
    "plc_io",
    "nodes",
    "connections",
    "network",
    "equipment_groups",
    "checks",
    "pdf_candidates",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[a-f0-9]{24}$"
    },
    "analysis_signature": {
      "type": "string"
    },
    "root_id": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/drawing"
      }
    },
    "drawings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/drawing"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "pdf_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "plc_io": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "module_device_id",
          "address",
          "sources",
          "relationship_basis"
        ],
        "properties": {
          "sources": {
            "$ref": "#/$defs/sources"
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "device_id",
          "sources"
        ]
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from_node",
          "to_node",
          "kind",
          "relationship_basis",
          "native_relationship",
          "sources",
          "domains",
          "wire_numbers"
        ],
        "properties": {
          "relationship_basis": {
            "enum": [
              "native_report",
              "attribute_assertion",
              "geometric_interpretation"
            ]
          },
          "native_relationship": {
            "type": "boolean"
          },
          "domains": {
            "type": "array",
            "items": {
              "enum": [
                "electrical",
                "network"
              ]
            }
          },
          "sources": {
            "$ref": "#/$defs/sources"
          }
        }
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "device_id",
          "sources",
          "relationship_basis"
        ]
      }
    },
    "equipment_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "value",
          "device_ids",
          "relationship_basis"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "severity",
          "sources"
        ]
      }
    },
    "scope": {
      "type": "string"
    }
  },
  "$defs": {
    "drawing": {
      "type": "object",
      "required": [
        "root_id",
        "relative_path",
        "sha256"
      ],
      "properties": {
        "root_id": {
          "type": "string"
        },
        "relative_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "native_relationship",
        "drawing",
        "object_handle",
        "reference_path",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "native_relationship": {
          "type": "boolean"
        },
        "drawing": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/drawing"
            }
          ]
        },
        "object_handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "device": {
      "type": "object",
      "required": [
        "id",
        "tag",
        "role",
        "device_type",
        "attributes",
        "sources",
        "field_sources"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      }
    }
  }
}
